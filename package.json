{
  "name": "karma-watch",
  "private": true,
  "scripts": {
    "backfill-dates": "node scanner/backfill-post-dates.js",
    "build": "node scripts/build-site.js",
    "build:demo": "node scripts/build-site.js --demo",
    "check": "node scripts/check.js",
    "demo": "npm run build:demo && node scripts/serve.js",
    "test": "node --test scanner/test/*.test.js",
    "verify": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
